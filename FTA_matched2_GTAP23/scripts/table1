# =============================================================================
# AVE comparison chart — three panels, colour by specification
#   A. Previous method: non-empirical   (dark blue)
#   B. Main specification: gravity controls (deep pink — the hero series)
#   C. Extension: bilateral FE          (turquoise)
#
# Broad sectors (Manufacturing / Services) are identified by bordered facet
# panels and right-hand strip labels, so colour is free to encode method.
# =============================================================================

library(dplyr)
library(forcats)
library(ggplot2)
library(scales)
library(patchwork)
library(ragg)


## ---- 1. Palette -------------------------------------------------------------
# UK Government Analysis Function categorical palette
af_blue   <- "#12436D"   # dark blue
af_teal   <- "#28A197"   # turquoise
af_pink   <- "#801650"   # dark pink
af_orange <- "#F46A25"   # orange

spec_levels <- c("Previous method (non-empirical)",
                 "Gravity controls",
                 "Bilateral FE")

# Deep pink sits on the main specification so the eye lands there first.
spec_cols <- c(
  "Previous method (non-empirical)" = af_blue,
  "Gravity controls"                = af_pink,
  "Bilateral FE"                    = af_teal
)

# Alternative: to visibly retire the old method, swap its colour for a neutral
# grey and let the two econometric specifications carry the colour:
# spec_cols[["Previous method (non-empirical)"]] <- "#8C8C8C"

# Chart furniture greys
grey_border <- "grey60"
grey_gridx  <- "grey91"
grey_gridy  <- "grey95"

# Leave "" for the device default; set to e.g. "Arial" if installed, so output
# is identical across machines.
chart_font <- ""


## ---- 2. Data-prep helper (regression tables) --------------------------------
prep_ave <- function(df) {
  df %>%
    filter(variable %in% c("FTA_matched_goods",          # agri dropped
                           "FTA_matched_services")) %>%
    left_join(GTAP_labels, by = c("GTAP_65" = "Code")) %>%
    filter(!is.na(Label)) %>%
    mutate(
      broad_sector_flag = case_when(
        version > 26 & version <= 45 ~ "Manufacturing",
        version > 45                 ~ "Services",
        TRUE                         ~ NA_character_
      )
    ) %>%
    filter(!is.na(broad_sector_flag))
}

grav <- prep_ave(results_table_gravity)      %>% mutate(spec = "Gravity controls")
bila <- prep_ave(results_table_bilateral_FE) %>% mutate(spec = "Bilateral FE")


## ---- 3. Old NTM AVE assumptions ---------------------------------------------
sector_meta <- results_table_gravity %>%
  distinct(GTAP_65, version) %>%
  mutate(
    broad_sector_flag = case_when(
      version <= 26                ~ "Agri",
      version > 26 & version <= 45 ~ "Manufacturing",
      version > 45                 ~ "Services",
      TRUE                         ~ NA_character_
    )
  )

old_ntm <- Old_NTMs %>%
  # 'Exports' is numeric on a percentage scale (e.g. -2.98).
  # If it is already a proportion (e.g. -0.0298), use AVE = Exports.
  mutate(AVE = Exports / 100) %>%
  left_join(sector_meta, by = "GTAP_65") %>%
  left_join(GTAP_labels, by = c("GTAP_65" = "Code")) %>%
  filter(!is.na(Label)) %>%
  filter(!is.na(broad_sector_flag), broad_sector_flag != "Agri") %>%
  mutate(spec = "Previous method (non-empirical)")


## ---- 4. Outlier rule, display window and shared ordering --------------------
# The outlier rule deletes; the display window only clips.
ave_limit <- 1
x_window  <- c(-0.4, 0.4)

all_specs <- bind_rows(old_ntm, grav, bila) %>%
  filter(AVE >= -ave_limit, AVE <= ave_limit)

# Ordering built from all three specifications so nothing is silently dropped.
# (For ordering on the main specification alone, replace all_specs with grav.)
sector_order <- all_specs %>%
  group_by(Label) %>%
  summarise(mean_ave = mean(AVE, na.rm = TRUE), .groups = "drop") %>%
  arrange(mean_ave) %>%
  pull(Label)

# Levels reversed so the chart reads most- to least-negative top to bottom.
apply_levels <- function(df) {
  df %>%
    filter(AVE >= -ave_limit, AVE <= ave_limit) %>%
    mutate(
      Label = factor(Label, levels = rev(sector_order)),
      broad_sector_flag = factor(broad_sector_flag,
                                 levels = c("Manufacturing", "Services")),
      spec = factor(spec, levels = spec_levels)
    ) %>%
    filter(!is.na(Label))
}

old_ntm   <- apply_levels(old_ntm)
grav      <- apply_levels(grav)
bila      <- apply_levels(bila)
all_specs <- apply_levels(all_specs)

n_clipped <- sum(all_specs$AVE < x_window[1] | all_specs$AVE > x_window[2])
message(n_clipped, " point(s) fall outside the display window and are clipped, ",
        "not removed.")


## ---- 5. Shared theme --------------------------------------------------------
panel_theme <- theme_minimal(base_size = 12, base_family = chart_font) +
  theme(
    plot.title.position = "plot",
    plot.title       = element_text(face = "bold", size = 13, colour = "grey15",
                                    hjust = 0, margin = margin(b = 8)),
    axis.text.y      = element_text(size = 8, colour = "grey20"),
    axis.text.x      = element_text(size = 9, colour = "grey30"),
    axis.title.x     = element_text(size = 10, colour = "grey30",
                                    margin = margin(t = 8)),
    # Bordered broad-sector panels
    panel.background = element_rect(fill = "white", colour = NA),
    panel.border     = element_rect(colour = grey_border, fill = NA,
                                    linewidth = 0.5),
    panel.grid.minor   = element_blank(),
    panel.grid.major.y = element_line(colour = grey_gridy, linewidth = 0.25),
    panel.grid.major.x = element_line(colour = grey_gridx, linewidth = 0.3),
    panel.spacing.y  = unit(12, "pt"),
    strip.text.y     = element_text(angle = 0, face = "bold", size = 9,
                                    colour = "grey25", hjust = 0,
                                    margin = margin(l = 8)),
    legend.position  = "top",
    legend.direction = "horizontal",
    legend.background = element_blank(),
    legend.key       = element_blank(),
    legend.title     = element_blank(),
    legend.text      = element_text(size = 9.5, colour = "grey25")
  )


## ---- 6. Shared scales and layers --------------------------------------------
x_scale <- scale_x_continuous(
  breaks = seq(x_window[1], x_window[2], 0.2),
  labels = label_percent(accuracy = 1)
)

x_window_coord <- coord_cartesian(xlim = x_window)   # clips, does not delete

zero_line <- geom_vline(xintercept = 0, linetype = "solid",
                        colour = "grey65", linewidth = 0.4)

facet_bs <- facet_grid(broad_sector_flag ~ ., scales = "free_y", space = "free")

x_lab <- "Ad-valorem equivalent (% of trade cost)"


## ---- 7. Panel builder -------------------------------------------------------
build_panel <- function(df, panel_title, show_y_text, show_strip, show_x_title) {
  p <- ggplot(df, aes(x = AVE, y = Label, colour = spec)) +
    zero_line +
    geom_point(size = 2.5, alpha = 0.95) +
    scale_colour_manual(values = spec_cols, drop = FALSE,
                        guide = guide_legend(override.aes = list(size = 3))) +
    x_scale + x_window_coord + facet_bs +
    labs(title = panel_title, x = x_lab, y = NULL) +
    panel_theme

  if (!show_y_text)    p <- p + theme(axis.text.y   = element_blank())
  if (!show_strip)     p <- p + theme(strip.text.y  = element_blank())
  if (!show_x_title)   p <- p + theme(axis.title.x  = element_blank())
  p
}

# Axis title appears once, under the centre panel, rather than three times.
p_old  <- build_panel(old_ntm, "A.  Previous method: non-empirical",
                      show_y_text = TRUE,  show_strip = FALSE,
                      show_x_title = FALSE)
p_grav <- build_panel(grav,    "B.  Main specification: gravity controls",
                      show_y_text = FALSE, show_strip = FALSE,
                      show_x_title = TRUE)
p_bila <- build_panel(bila,    "C.  Extension: bilateral FE",
                      show_y_text = FALSE, show_strip = TRUE,
                      show_x_title = FALSE)


## ---- 8. Combine -------------------------------------------------------------
final_plot <-
  (p_old | p_grav | p_bila) +
  plot_layout(widths = c(1, 1, 1), guides = "collect") +
  plot_annotation(
    title    = "Comparing AVE results across three methodologies",
    subtitle = paste("Sectors ordered from most to least negative AVE,",
                     "top to bottom | Estimates outside \u00b1100% excluded"),
    caption  = "Department for Business, Innovation, Science and Trade",
    theme = theme(
      plot.title.position = "plot",
      plot.title    = element_text(face = "bold", size = 16, colour = "grey15",
                                   hjust = 0, family = chart_font),
      plot.subtitle = element_text(colour = "grey45", size = 12, hjust = 0,
                                   margin = margin(b = 10), family = chart_font),
      plot.caption  = element_text(colour = "grey50", size = 9, hjust = 0,
                                   family = chart_font),
      plot.margin   = margin(14, 18, 10, 12)
    )
  ) &
  theme(legend.position = "top")

final_plot


## ---- 9. Export --------------------------------------------------------------
save_chart <- function(plot, file, width, height, res = 320) {
  agg_png(file, width = width, height = height, units = "in",
          res = res, background = "white")
  print(plot)
  dev.off()
  invisible(file)
}

