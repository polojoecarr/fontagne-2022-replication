# =============================================================================
# AVE comparison chart — specification across columns, broad sector down rows
#   A. Previous method: non-empirical       (dark blue)
#   B. Main specification: gravity controls (deep pink — the hero series)
#   C. Extension: bilateral FE              (turquoise)
#
# Built as ONE ggplot faceted spec x broad sector rather than three plots
# stitched together, so column widths and row heights align by construction.
# No legend: each column heading names its own specification.
# =============================================================================

library(dplyr)
library(forcats)
library(ggplot2)
library(scales)
library(ragg)


## ---- 1. Palette -------------------------------------------------------------
# UK Government Analysis Function categorical palette
af_blue   <- "#12436D"   # dark blue
af_teal   <- "#28A197"   # turquoise
af_pink   <- "#801650"   # dark pink
af_orange <- "#F46A25"   # orange

spec_levels <- c("Previous method (non-empirical)",
                 "Gravity controls",
                 "Bilateral FE")

spec_cols <- c(
  "Previous method (non-empirical)" = af_blue,
  "Gravity controls"                = af_pink,
  "Bilateral FE"                    = af_teal
)

# Column headings
spec_labs <- c(
  "Previous method (non-empirical)" = "A.  Previous method: non-empirical",
  "Gravity controls"                = "B.  Main specification: gravity controls",
  "Bilateral FE"                    = "C.  Extension: bilateral FE"
)

# Alternative: to visibly retire the old method, grey it out and let the two
# econometric specifications carry the colour:
# spec_cols[["Previous method (non-empirical)"]] <- "#8C8C8C"

# Backgrounds: grey page, white panels — panels sit forward off the canvas.
# To invert this (grey panels on a white page), set page_bg to "white" and
# panel_bg to "grey96".
page_bg     <- "#F4F5F7"
panel_bg    <- "white"
grey_border <- "grey60"
grey_gridx  <- "grey88"
grey_gridy  <- "grey93"

# Leave "" for the device default; set to e.g. "Arial" if installed.
chart_font <- ""


## ---- 2. Data-prep helper (regression tables) --------------------------------
prep_ave <- function(df) {
  df %>%
    filter(variable %in% c("FTA_matched_goods",          # agri dropped
                           "FTA_matched_services")) %>%
    left_join(GTAP_labels, by = c("GTAP_65" = "Code")) %>%
    filter(!is.na(Label)) %>%
    mutate(
      broad_sector_flag = case_when(
        version > 26 & version <= 45 ~ "Manufacturing",
        version > 45                 ~ "Services",
        TRUE                         ~ NA_character_
      )
    ) %>%
    filter(!is.na(broad_sector_flag))
}

grav <- prep_ave(results_table_gravity)      %>% mutate(spec = "Gravity controls")
bila <- prep_ave(results_table_bilateral_FE) %>% mutate(spec = "Bilateral FE")


## ---- 3. Old NTM AVE assumptions ---------------------------------------------
sector_meta <- results_table_gravity %>%
  distinct(GTAP_65, version) %>%
  mutate(
    broad_sector_flag = case_when(
      version <= 26                ~ "Agri",
      version > 26 & version <= 45 ~ "Manufacturing",
      version > 45                 ~ "Services",
      TRUE                         ~ NA_character_
    )
  )

old_ntm <- Old_NTMs %>%
  # 'Exports' is numeric on a percentage scale (e.g. -2.98).
  # If it is already a proportion (e.g. -0.0298), use AVE = Exports.
  mutate(AVE = Exports / 100) %>%
  left_join(sector_meta, by = "GTAP_65") %>%
  left_join(GTAP_labels, by = c("GTAP_65" = "Code")) %>%
  filter(!is.na(Label)) %>%
  filter(!is.na(broad_sector_flag), broad_sector_flag != "Agri") %>%
  mutate(spec = "Previous method (non-empirical)")


## ---- 4. Outlier rule, display window and ordering ---------------------------
# The outlier rule deletes; the display window only clips.
ave_limit <- 1
x_window  <- c(-0.4, 0.4)

plot_data <- bind_rows(old_ntm, grav, bila) %>%
  filter(AVE >= -ave_limit, AVE <= ave_limit)

# Ordering built from all three specifications so nothing is silently dropped.
# (To order on the main specification alone, filter to spec == "Gravity controls".)
sector_order <- plot_data %>%
  group_by(Label) %>%
  summarise(mean_ave = mean(AVE, na.rm = TRUE), .groups = "drop") %>%
  arrange(mean_ave) %>%
  pull(Label)

# Levels reversed so the chart reads most- to least-negative top to bottom.
plot_data <- plot_data %>%
  mutate(
    Label = factor(Label, levels = rev(sector_order)),
    broad_sector_flag = factor(broad_sector_flag,
                               levels = c("Manufacturing", "Services")),
    spec = factor(spec, levels = spec_levels)
  ) %>%
  filter(!is.na(Label))

n_clipped <- sum(plot_data$AVE < x_window[1] | plot_data$AVE > x_window[2])
message(n_clipped, " point(s) fall outside the display window and are clipped, ",
        "not removed.")


## ---- 5. Chart ---------------------------------------------------------------
final_plot <-
  ggplot(plot_data, aes(x = AVE, y = Label, colour = spec)) +
  geom_vline(xintercept = 0, colour = "grey65", linewidth = 0.4) +
  geom_point(size = 2.5, alpha = 0.95) +
  scale_colour_manual(values = spec_cols, drop = FALSE, guide = "none") +
  scale_x_continuous(breaks = seq(x_window[1], x_window[2], 0.2),
                     labels = label_percent(accuracy = 1)) +
  coord_cartesian(xlim = x_window) +          # clips, does not delete
  # Columns are equal and rows share a y-scale by construction: no manual
  # width tuning, and the sector labels are drawn once for the whole grid.
  facet_grid(broad_sector_flag ~ spec,
             scales   = "free_y",
             space    = "free_y",
             labeller = labeller(spec = spec_labs)) +
  labs(
    title    = "Comparing AVE results across three methodologies",
    subtitle = paste("Sectors ordered from most to least negative AVE,",
                     "top to bottom | Estimates outside \u00b1100% excluded"),
    caption  = "Department for Business, Innovation, Science and Trade",
    x = "Ad-valorem equivalent (% of trade cost)",
    y = NULL
  ) +
  theme_minimal(base_size = 12, base_family = chart_font) +
  theme(
    plot.title.position = "plot",
    plot.title    = element_text(face = "bold", size = 16, colour = "grey15",
                                 hjust = 0, margin = margin(b = 4)),
    plot.subtitle = element_text(colour = "grey45", size = 12, hjust = 0,
                                 margin = margin(b = 12)),
    plot.caption  = element_text(colour = "grey50", size = 9, hjust = 0,
                                 margin = margin(t = 10)),
    # Grey canvas, white bordered panels
    plot.background  = element_rect(fill = page_bg, colour = NA),
    panel.background = element_rect(fill = panel_bg, colour = NA),
    panel.border     = element_rect(colour = grey_border, fill = NA,
                                    linewidth = 0.5),
    panel.grid.minor   = element_blank(),
    panel.grid.major.y = element_line(colour = grey_gridy, linewidth = 0.25),
    panel.grid.major.x = element_line(colour = grey_gridx, linewidth = 0.3),
    panel.spacing.x  = unit(14, "pt"),
    panel.spacing.y  = unit(12, "pt"),
    # Column headings act as the old panel titles
    strip.background.x = element_blank(),
    strip.text.x       = element_text(face = "bold", size = 12.5,
                                      colour = "grey15", hjust = 0,
                                      margin = margin(b = 8)),
    # Broad-sector labels down the right-hand edge
    strip.background.y = element_blank(),
    strip.text.y       = element_text(angle = 0, face = "bold", size = 9,
                                      colour = "grey20", hjust = 0,
                                      margin = margin(l = 8)),
    axis.text.y  = element_text(size = 8, colour = "grey20"),
    axis.text.x  = element_text(size = 9, colour = "grey30"),
    axis.title.x = element_text(size = 10, colour = "grey30",
                                margin = margin(t = 8)),
    legend.position = "none",
    plot.margin  = margin(14, 18, 10, 12)
  )

final_plot


## ---- 6. Export --------------------------------------------------------------
save_chart <- function(plot, file, width, height, res = 320) {
  agg_png(file, width = width, height = height, units = "in",
          res = res, background = page_bg)
  print(plot)
  dev.off()
  invisible(file)
}

