# ---- packages ---------------------------------------------------------------
library(dplyr)
library(ggplot2)
library(scales)
library(ragg)

# ---- parameters -------------------------------------------------------------
af_blue  <- "#12436D"
grey_out <- "grey72"

thresh <- 0.25      # match window: both scores <= 0.25
xmax   <- 0.7
ymax   <- 0.7
step   <- 0.1

# ---- prep -------------------------------------------------------------------
plot_data <- final_distance_data %>%
  filter(!is.na(per_distance_services_manhattan_active),
         !is.na(per_distance_services_manhattan)) %>%
  mutate(
    matched = per_distance_services_manhattan_active <= thresh &
              per_distance_services_manhattan        <= thresh
  )

n_matched <- sum(plot_data$matched)
n_total   <- nrow(plot_data)

lab_matched <- sprintf("Matched (n = %s)", n_matched)
lab_other   <- sprintf("Not matched (n = %s)", n_total - n_matched)

plot_data <- plot_data %>%
  mutate(match_lab = factor(ifelse(matched, lab_matched, lab_other),
                            levels = c(lab_matched, lab_other)))

match_cols <- setNames(c(af_blue, grey_out), c(lab_matched, lab_other))

# ---- plot -------------------------------------------------------------------
p_services <- ggplot(plot_data,
                     aes(x = per_distance_services_manhattan_active,
                         y = per_distance_services_manhattan)) +

  # match window
  annotate("rect", xmin = 0, xmax = thresh, ymin = 0, ymax = thresh,
           fill = af_blue, alpha = 0.06) +
  annotate("segment", x = thresh, xend = thresh, y = 0, yend = thresh,
           colour = af_blue, linetype = "22", linewidth = 0.4, alpha = 0.8) +
  annotate("segment", x = 0, xend = thresh, y = thresh, yend = thresh,
           colour = af_blue, linetype = "22", linewidth = 0.4, alpha = 0.8) +

  # 45-degree reference
  geom_abline(slope = 1, intercept = 0,
              colour = "grey80", linetype = "12", linewidth = 0.3) +

  geom_point(aes(fill = match_lab),
             shape = 21, size = 2.2, stroke = 0.3,
             colour = "white", alpha = 0.9) +

  annotate("text", x = thresh + 0.015, y = thresh + 0.015,
           label = "Match window:\nboth scores \u2264 0.25",
           hjust = 0, vjust = 0, size = 2.9, colour = "grey35",
           lineheight = 0.95) +

  scale_fill_manual(values = match_cols, name = NULL) +
  scale_x_continuous(limits = c(0, xmax), breaks = seq(0, xmax, by = step),
                     labels = label_number(accuracy = 0.1),
                     expand = expansion(mult = 0)) +
  scale_y_continuous(limits = c(0, ymax), breaks = seq(0, ymax, by = step),
                     labels = label_number(accuracy = 0.1),
                     expand = expansion(mult = 0)) +
  coord_fixed() +

  labs(
    title    = "Active and total distance scores move closely together",
    subtitle = "Services sectors: comparator FTAs falling inside the shaded window are selected as matches",
    x        = "Active distance score",
    y        = "Total distance score",
    caption  = paste("Source: World Bank Contents of Deep Trade Agreements 2.0;",
                     "authors' calculations.\nDepartment for Business, Innovation, Science and Trade")
  ) +

  theme_minimal(base_size = 11) +
  theme(
    plot.title          = element_text(face = "bold", size = 14, margin = margin(b = 4)),
    plot.subtitle       = element_text(colour = "grey35", size = 10, margin = margin(b = 14)),
    plot.caption        = element_text(colour = "grey55", size = 8, hjust = 0,
                                       lineheight = 1.1, margin = margin(t = 12)),
    plot.title.position = "plot",
    plot.caption.position = "plot",
    axis.title          = element_text(colour = "grey30", size = 9.5),
    axis.title.x        = element_text(margin = margin(t = 8)),
    axis.title.y        = element_text(margin = margin(r = 8)),
    panel.grid.minor    = element_blank(),
    panel.grid.major    = element_line(colour = "grey93", linewidth = 0.3),
    panel.border        = element_rect(colour = "grey85", fill = NA, linewidth = 0.4),
    legend.position     = "bottom",
    legend.justification = "left",
    legend.text         = element_text(size = 9, colour = "grey30"),
    legend.key.size     = unit(10, "pt"),
    legend.margin       = margin(t = 4),
    plot.margin         = margin(16, 20, 12, 16)
  )

p_services

# ---- export -----------------------------------------------------------------
ggsave("Applications/John Hoy/distance_distribution_services.png", p_services,
       width = 7.5, height = 7.5, dpi = 320, device = ragg::agg_png, bg = "white")