library(ggplot2)
library(dplyr)
library(scales)

final_distance_data %>%
  mutate(
    dist_from_origin = sqrt(
      per_distance_agri_manhattan_active^2 +
      per_distance_agri_manhattan^2
    )
  ) %>%
  ggplot(aes(
    x = per_distance_agri_manhattan_active,
    y = per_distance_agri_manhattan
  )) +
  # density shading, mapped to fill so the alpha scale stays free for points
  stat_density_2d(
    aes(fill = after_stat(level)),
    geom = "polygon", colour = NA, bins = 7
  ) +
  scale_fill_gradient(low = "white", high = "grey86", guide = "none") +
  geom_point(
    aes(colour = dist_from_origin,
        size   = dist_from_origin,
        alpha  = dist_from_origin),
    stroke = 0
  ) +
  # mako runs dark -> pale; direction = 1 puts dark at the origin.
  # end = 0.72 stops the ramp before it washes out against the panel.
  scale_colour_viridis_c(
    option = "mako", direction = 1, begin = 0.08, end = 0.72,
    name = "Distance\nfrom origin",
    guide = guide_colourbar(
      barheight = unit(55, "pt"), barwidth = unit(8, "pt"),
      ticks = FALSE, title.vjust = 1
    )
  ) +
  # descending ranges: near-origin points are larger and more opaque
  scale_size_continuous(range = c(3.2, 1.3), guide = "none") +
  scale_alpha_continuous(range = c(0.95, 0.5), guide = "none") +
  scale_x_continuous(labels = label_number(accuracy = 0.01),
                     expand = expansion(mult = 0.03)) +
  scale_y_continuous(labels = label_number(accuracy = 0.01),
                     expand = expansion(mult = 0.03)) +
  labs(
    title = "FTA population distribution for agricultural sectors",
    subtitle = "Active vs. total distance scores; darker, larger points sit closer to the origin",
    x = "Active distance score",
    y = "Total distance score",
    caption = "Source: World Bank Contents of Deep Trade Agreements 2.0"
  ) +
  theme_minimal(base_size = 11) +
  theme(
    plot.title = element_text(face = "bold", size = 14, margin = margin(b = 4)),
    plot.subtitle = element_text(colour = "grey35", size = 10, margin = margin(b = 14)),
    plot.caption = element_text(colour = "grey55", size = 8, hjust = 0),
    plot.title.position = "plot",
    axis.title = element_text(colour = "grey30", size = 9.5),
    axis.title.x = element_text(margin = margin(t = 8)),
    axis.title.y = element_text(margin = margin(r = 8)),
    panel.grid.minor = element_blank(),
    panel.grid.major = element_line(colour = "grey92", linewidth = 0.3),
    legend.title = element_text(size = 9, colour = "grey30"),
    legend.text = element_text(size = 8),
    plot.margin = margin(16, 20, 12, 16)
  )