# ---- packages -----------------------------------------------------------
library(ggplot2)
library(dplyr)
library(scales)
library(ragg)      # install.packages("ragg") if you haven't

# ---- data ---------------------------------------------------------------
plot_data <- final_distance_data %>%
  mutate(
    dist_from_origin = sqrt(
      per_distance_agri_manhattan_active^2 +
      per_distance_agri_manhattan^2
    )
  )

xmax <- max(plot_data$per_distance_agri_manhattan_active, na.rm = TRUE) * 1.03
ymax <- max(plot_data$per_distance_agri_manhattan,        na.rm = TRUE) * 1.03

# ---- constant-distance arcs, clipped to the visible panel ---------------
radii <- c(0.3, 0.5, 0.7, 0.9)

arc_path <- function(r) {
  th <- seq(0, pi / 2, length.out = 400)
  d  <- data.frame(x = r * cos(th), y = r * sin(th), r = r)
  d[d$x <= xmax & d$y <= ymax, ]
}

arcs <- bind_rows(lapply(radii, arc_path))

arc_labels <- arcs %>%                 # label at each arc's highest visible point
  group_by(r) %>%
  slice_max(y, n = 1, with_ties = FALSE) %>%
  ungroup() %>%
  mutate(x = x + 0.015, y = y - 0.015,
         label = formatC(r, format = "f", digits = 1))

# ---- plot ---------------------------------------------------------------
p <- ggplot(plot_data, aes(x = per_distance_agri_manhattan_active,
                           y = per_distance_agri_manhattan)) +
  geom_path(data = arcs, aes(x = x, y = y, group = r),
            colour = "grey80", linewidth = 0.3, linetype = "22",
            inherit.aes = FALSE) +
  geom_text(data = arc_labels, aes(x = x, y = y, label = label),
            colour = "grey65", size = 2.6, hjust = 0, vjust = 1,
            inherit.aes = FALSE) +
  geom_point(aes(colour = dist_from_origin,
                 size   = dist_from_origin,
                 alpha  = dist_from_origin),
             shape = 16) +
  scale_colour_viridis_c(
    option = "mako", direction = 1, begin = 0.05, end = 0.70,
    name = "Distance\nfrom origin",
    guide = guide_colourbar(barheight = unit(55, "pt"),
                            barwidth  = unit(8, "pt"),
                            ticks = FALSE, title.vjust = 1)
  ) +
  scale_size_continuous(range = c(3.4, 1.2), guide = "none") +
  scale_alpha_continuous(range = c(0.95, 0.45), guide = "none") +
  scale_x_continuous(limits = c(0, xmax), labels = label_number(accuracy = 0.01),
                     expand = expansion(mult = 0)) +
  scale_y_continuous(limits = c(0, ymax), labels = label_number(accuracy = 0.01),
                     expand = expansion(mult = 0)) +
  coord_fixed() +
  labs(
    title    = "FTA population distribution for agricultural sectors",
    subtitle = "Darker, larger points sit closer to the origin; dashed arcs mark equal distance",
    x        = "Active distance score",
    y        = "Total distance score",
    caption  = "Source: World Bank Contents of Deep Trade Agreements 2.0"
  ) +
  theme_minimal(base_size = 11) +
  theme(
    plot.title       = element_text(face = "bold", size = 14, margin = margin(b = 4)),
    plot.subtitle    = element_text(colour = "grey35", size = 10, margin = margin(b = 14)),
    plot.caption     = element_text(colour = "grey55", size = 8, hjust = 0),
    plot.title.position = "plot",
    axis.title       = element_text(colour = "grey30", size = 9.5),
    axis.title.x     = element_text(margin = margin(t = 8)),
    axis.title.y     = element_text(margin = margin(r = 8)),
    panel.grid.minor = element_blank(),
    panel.grid.major = element_line(colour = "grey93", linewidth = 0.3),
    legend.title     = element_text(size = 9, colour = "grey30"),
    legend.text      = element_text(size = 8),
    plot.margin      = margin(16, 20, 12, 16)
  )

p

# ---- export -------------------------------------------------------------
ggsave("fta_distribution.png", p, width = 9, height = 6.5,
       dpi = 320, device = ragg::agg_png, bg = "white")